  $definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('visit');
  foreach (['congenital_abnormality', 'neuro_peds', 'nutrition', 'ted_stockings'] as $name) {
    $definition = $definitions[$name] ?? NULL;
