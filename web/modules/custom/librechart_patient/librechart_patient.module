<?php

/**
 * @file
 * Librechart Patient module hooks and functions.
 */

declare(strict_types=1);

use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\librechart_patient\Service\PatientDuplicateChecker;

/**
 * Implements hook_gin_ignore_sticky_form_actions().
 *
 * Opts the patient form out of Gin's sticky-action bar. On the patient chart
 * the patient form is embedded alongside the visit form; Gin's sticky header
 * Save submits only the patient form, so clicking it reloads the page without
 * saving the visit edits below it. Removing the sticky duplicate leaves the
 * in-form Save buttons, which submit the correct form (feature 005).
 *
 * @return array<int, string>
 *   Form ids to exclude from Gin's sticky form actions.
 */
function librechart_patient_gin_ignore_sticky_form_actions(): array {
  return ['patient_add_form', 'patient_edit_form'];
}

/**
 * Implements hook_form_alter().
 *
 * Adds a duplicate patient warning on the patient add form, and keeps the
 * visit form's read-only patient_type in sync with the patient's age.
 */
function librechart_patient_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Keep the visit form's patient_type aligned with the selected patient.
  _librechart_patient_sync_visit_patient_type($form, $form_state, $form_id);

  if (!in_array($form_id, ['patient_add_form', 'patient_edit_form'], TRUE)) {
    return;
  }

  // Revisions are created automatically on every save (see Patient::preSave),
  // so the core "Create new revision" / revision log controls are redundant.
  // Hide them from everyone except administrators (the Revisions tab is
  // already gated by permission).
  $is_patient_admin = \Drupal::currentUser()->hasPermission('administer patient entities');
  if (isset($form['revision_information'])) {
    $form['revision_information']['#access'] = $is_patient_admin;
  }
  // Revisions are created automatically on every save (Patient::preSave), so the
  // manual "Create new revision" checkbox is a no-op — hide it from everyone.
  // Admins keep the log message field to annotate the change.
  if (isset($form['revision'])) {
    $form['revision']['#access'] = FALSE;
  }
  if (isset($form['revision_log_message'])) {
    $form['revision_log_message']['#access'] = $is_patient_admin;
  }

  // Auto-calculated Age shown beside Date of Birth, read-only (mirrors the
  // BMI field on the visit). Age is derived from date_of_birth and changes
  // over time, so it is never stored: it is computed here at render and
  // recomputed live in the browser by the age_calc behaviour as the DOB
  // input changes.
  if (isset($form['date_of_birth'])) {
    $patient = $form_state->getFormObject()->getEntity();
    $dob = ($patient instanceof EntityInterface
      && $patient->hasField('date_of_birth')
      && !$patient->get('date_of_birth')->isEmpty())
      ? (string) $patient->get('date_of_birth')->value
      : '';
    $form['age_display'] = [
      '#type' => 'textfield',
      '#title' => t('Age'),
      '#disabled' => TRUE,
      '#default_value' => _librechart_patient_format_age($dob),
      '#weight' => ($form['date_of_birth']['#weight'] ?? 12) + 0.5,
      '#attributes' => [
        'data-librechart-age' => 'value',
        'class' => ['lc-age-display'],
      ],
      // Closes the flex row opened on the Date of Birth field below.
      '#suffix' => '</div>',
    ];
    // Tag the DOB input so the behaviour can recompute age as it changes, and
    // wrap both fields in a flex row so Age sits beside Date of Birth.
    if (isset($form['date_of_birth']['widget'][0]['value'])) {
      $form['date_of_birth']['widget'][0]['value']['#attributes']['data-librechart-age-dob'] = 'true';
    }
    $form['date_of_birth']['#prefix'] = '<div class="lc-patient-field-row">';
    $form['#attached']['library'][] = 'librechart_patient/age_calc';
  }

  // The remaining duplicate-validation and redirect behavior applies only when
  // registering a new patient.
  if ($form_id !== 'patient_add_form') {
    return;
  }

  $form['#validate'][] = 'librechart_patient_form_patient_validate_duplicates';

  // Send the user to the patient chart (edit form) instead of the entity's
  // default collection/canonical destination so they can immediately start
  // a visit from the chart.
  if (isset($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = '_librechart_patient_redirect_to_edit';
  }
}

/**
 * Formats a patient's age from a date-of-birth string.
 *
 * Returns whole years for patients 18 and over, and years plus months for
 * patients under 18 (e.g. "3 years 4 months"). Returns an empty string when
 * the date is missing, unparseable, or in the future. Mirrors the logic in
 * js/age-calc.js so the server-rendered value matches the live one.
 *
 * @param string $dob
 *   The date of birth as a 'Y-m-d' string, or '' when unset.
 *
 * @return string
 *   The formatted age, or '' when it cannot be computed.
 */
function _librechart_patient_format_age(string $dob): string {
  if ($dob === '') {
    return '';
  }
  try {
    $birth = new \DateTime(substr($dob, 0, 10));
  }
  catch (\Throwable $e) {
    return '';
  }
  $today = new \DateTime('today');
  if ($birth > $today) {
    return '';
  }
  $diff = $today->diff($birth);
  $years = (int) $diff->y;
  if ($years >= 18) {
    return (string) \Drupal::translation()->formatPlural($years, '1 year', '@count years');
  }
  $months = (int) $diff->m;
  $year_part = \Drupal::translation()->formatPlural($years, '1 year', '@count years');
  $month_part = \Drupal::translation()->formatPlural($months, '1 month', '@count months');
  return $year_part . ' ' . $month_part;
}

/**
 * Submit handler: after saving a new patient, redirect to its edit form
 * (the chart page rendered by PatientChartController::edit).
 */
function _librechart_patient_redirect_to_edit(array &$form, FormStateInterface $form_state): void {
  $patient = $form_state->getFormObject()->getEntity();
  if ($patient && method_exists($patient, 'id') && $patient->id()) {
    $form_state->setRedirect('entity.patient.edit_form', ['patient' => (int) $patient->id()]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for the patient entity.
 *
 * Auto-creates a Visit at the 'registration' station for every newly
 * registered patient. This makes the patient appear in the Registration
 * column of the Floor board so triage staff can see who is waiting. The
 * visit uses the entity's built-in defaults (patient_type=adult,
 * status=in_progress, visit_date=now); clinic_site is left empty for the
 * triage nurse to fill when they pick up the patient.
 *
 * Defensive: skips creation if a visit already exists for this patient
 * (e.g. if some other code path created one first).
 */
function librechart_patient_patient_insert(EntityInterface $patient): void {
  $visit_storage = \Drupal::entityTypeManager()->getStorage('visit');

  $existing = (int) $visit_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('patient', $patient->id())
    ->count()
    ->execute();
  if ($existing > 0) {
    return;
  }

  $visit = $visit_storage->create([
    'patient' => $patient->id(),
    'current_station' => 'registration',
  ]);
  // patient_type is derived from the patient's age on save; see
  // librechart_patient_visit_presave().
  $visit->save();
}

/**
 * Implements hook_ENTITY_TYPE_presave() for the visit entity.
 *
 * Keeps patient_type in lockstep with the patient's age on every save: under 18
 * is pediatric, otherwise adult. The field is auto-managed and read-only on the
 * form, so deriving it here means a corrected date of birth is reflected
 * automatically and the value can never drift from the patient's age.
 *
 * @param \Drupal\Core\Entity\EntityInterface $visit
 *   The visit being saved.
 */
function librechart_patient_visit_presave(EntityInterface $visit): void {
  if (!$visit instanceof FieldableEntityInterface
    || !$visit->hasField('patient_type')
    || !$visit->hasField('patient')) {
    return;
  }
  $patients = $visit->get('patient')->referencedEntities();
  $patient = $patients[0] ?? NULL;
  if ($patient instanceof EntityInterface) {
    $visit->set('patient_type', _librechart_patient_age_type($patient));
  }
}

/**
 * Keeps the read-only patient_type widget in lockstep with the patient's age.
 *
 * patient_type is authoritatively re-derived on save
 * (librechart_patient_visit_presave), but the value also drives the pediatric
 * conditional fields on the form, so it must be correct before the visit is
 * saved:
 *
 * - On the add form the patient has not been saved yet, so without this the
 *   disabled select would show the 'adult' default even for a pediatric
 *   patient, hiding the pediatric fields. Selecting a patient rebuilds the
 *   form (the pediatric fields live in different field groups, so only a full
 *   rebuild re-evaluates their #states against the new patient_type).
 * - On the edit form this also corrects the displayed value immediately when a
 *   patient's date of birth has been amended since the visit was last saved.
 *
 * @param array<array-key, mixed> $form
 *   The visit form, passed by reference and mutated in place.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 * @param string $form_id
 *   The form id.
 */
function _librechart_patient_sync_visit_patient_type(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!in_array($form_id, ['visit_add_form', 'visit_edit_form'], TRUE)) {
    return;
  }
  if (!isset($form['patient']['widget']) || !isset($form['patient_type']['widget'])) {
    return;
  }

  // Re-derive patient_type live when the patient is chosen on-screen (add
  // form). The patient field is locked on the edit form, so there is nothing
  // to react to there.
  $patient_editable = empty($form['patient']['widget']['#disabled'])
    && ($form['patient']['#access'] ?? TRUE);
  if ($patient_editable) {
    $wrapper = 'visit-patient-type-sync';
    $form['#prefix'] = ($form['#prefix'] ?? '') . '<div id="' . $wrapper . '">';
    $form['#suffix'] = '</div>' . ($form['#suffix'] ?? '');
    $form['patient']['widget']['#ajax'] = [
      'callback' => '_librechart_patient_visit_form_ajax',
      'wrapper' => $wrapper,
      'event' => 'change',
    ];
  }

  // Push the derived type into the read-only widget so the value, and the
  // conditional pediatric fields that key off it, reflect the current patient.
  $patient = _librechart_patient_resolve_form_patient($form_state);
  if ($patient instanceof EntityInterface) {
    $type = _librechart_patient_age_type($patient);
    // Disabled selects take their rendered value from #default_value.
    $form['patient_type']['widget']['#default_value'] = [$type];
    $form['patient_type']['widget']['#value'] = [$type];
  }
}

/**
 * AJAX callback for the visit form: returns the whole form to re-render it.
 *
 * @param array<array-key, mixed> $form
 *   The rebuilt form.
 *
 * @return array<array-key, mixed>
 *   The rebuilt form, with patient_type re-derived from the new patient.
 */
function _librechart_patient_visit_form_ajax(array $form, FormStateInterface $form_state): array {
  return $form;
}

/**
 * Resolves the patient currently selected on the visit form.
 *
 * Reads the live selection from the submitted value first (so AJAX rebuilds
 * pick up a just-chosen patient) and falls back to the patient referenced on
 * the entity (initial page build and the edit form, where the field is locked).
 *
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 *
 * @return \Drupal\Core\Entity\EntityInterface|null
 *   The selected patient, or NULL when none is set.
 */
function _librechart_patient_resolve_form_patient(FormStateInterface $form_state): ?EntityInterface {
  $id = NULL;
  $value = $form_state->getValue('patient');
  if (is_array($value)) {
    $first = $value[0] ?? $value;
    $id = is_array($first) ? ($first['target_id'] ?? NULL) : (is_scalar($first) ? $first : NULL);
  }
  elseif (is_scalar($value)) {
    $id = $value;
  }
  // The raw select value is the most reliable source during an AJAX rebuild.
  if (!$id) {
    $input = $form_state->getUserInput();
    $id = is_scalar($input['patient'] ?? NULL) ? $input['patient'] : NULL;
  }
  if ($id !== NULL && $id !== '' && ctype_digit((string) $id)) {
    $patient = \Drupal::entityTypeManager()->getStorage('patient')->load($id);
    return $patient instanceof EntityInterface ? $patient : NULL;
  }

  // Fall back to the patient already referenced on the entity.
  $form_object = $form_state->getFormObject();
  $entity = $form_object instanceof EntityFormInterface ? $form_object->getEntity() : NULL;
  if ($entity instanceof FieldableEntityInterface && $entity->hasField('patient')) {
    $patients = $entity->get('patient')->referencedEntities();
    return $patients[0] ?? NULL;
  }
  return NULL;
}

/**
 * Derives a visit's patient_type ('pediatric'/'adult') from the patient's DOB.
 *
 * Patients under 18 are pediatric. Falls back to 'adult' (the field default)
 * when the date of birth is missing, unparseable, or in the future.
 *
 * @param \Drupal\Core\Entity\EntityInterface $patient
 *   The patient entity.
 *
 * @return string
 *   Either 'pediatric' or 'adult'.
 */
function _librechart_patient_age_type(EntityInterface $patient): string {
  if (!$patient instanceof FieldableEntityInterface
    || !$patient->hasField('date_of_birth')
    || $patient->get('date_of_birth')->isEmpty()) {
    return 'adult';
  }
  try {
    $birth = new \DateTime(substr((string) $patient->get('date_of_birth')->value, 0, 10));
  }
  catch (\Throwable $e) {
    return 'adult';
  }
  $today = new \DateTime('today');
  if ($birth > $today) {
    return 'adult';
  }
  return $today->diff($birth)->y < 18 ? 'pediatric' : 'adult';
}

/**
 * Form validation handler — checks for potential duplicate patients.
 */
function librechart_patient_form_patient_validate_duplicates(array &$form, FormStateInterface $form_state): void {
  $last_name = $form_state->getValue(['last_name', 0, 'value']);
  $dob = $form_state->getValue(['date_of_birth', 0, 'value']);

  // The datetime widget can hand us either a DrupalDateTime (after its own
  // validator runs) or the raw YYYY-MM-DD string. Normalize to the string
  // form the service contract expects.
  if ($dob instanceof DrupalDateTime) {
    $dob = $dob->format('Y-m-d');
  }

  if (empty($last_name) || empty($dob)) {
    return;
  }

  /** @var \Drupal\librechart_patient\Service\PatientDuplicateChecker $checker */
  $checker = \Drupal::service('librechart_patient.duplicate_checker');
  $matches = $checker->findPotentialDuplicates($last_name, (string) $dob);

  if (!empty($matches)) {
    $items = [];
    foreach ($matches as $patient) {
      $items[] = $patient->getLastName() . ', ' . $patient->getFirstName()
        . ' — ' . $patient->getCedula()
        . ' — ' . $patient->getDateOfBirth();
    }
    $list = implode('; ', $items);
    \Drupal::messenger()->addWarning(t(
      'Potential duplicate patients found: @list. Please verify before saving.',
      ['@list' => $list]
    ));
  }
}
